  "fixed_sql": [
    {
      "name": "playback_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_progress\" (\"media_id\" TEXT NOT NULL, \"position_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"audio_track_id\" TEXT NULL, \"subtitle_track_id\" TEXT NULL, \"last_played_source_key\" TEXT NULL, PRIMARY KEY (\"media_id\"));"
        }
      ]
    },
    {
      "name": "favourites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favourites\" (\"media_id\" TEXT NOT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"media_id\"));"
        }
      ]
    },
    {
      "name": "next_up",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"next_up\" (\"series_id\" TEXT NOT NULL, \"media_id\" TEXT NOT NULL, \"season\" INTEGER NOT NULL, \"episode\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"series_id\"));"
        }
      ]
    },
    {
      "name": "download_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_records\" (\"source_key\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"file_path\" TEXT NULL, \"total_bytes\" INTEGER NULL, \"validator\" TEXT NULL, \"last_used_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_key\"));"
        }
      ]
    },
    {
