      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"torrent_resume\" (\"info_hash\" TEXT NOT NULL, \"data\" BLOB NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"info_hash\"));"
        }
