 static int control(struct vo *vo, uint32_t request, void *data)
 {
+    struct priv *p = vo->priv;
+    switch (request) {
+    case VOCTRL_RESET:
+        p->overlay_pts = MP_NOPTS_VALUE;
+        p->overlay_change_id = -1;
+        overlay_update(vo, p->overlay_pts);
+        return VO_TRUE;
+    case VOCTRL_PAUSE:
+    case VOCTRL_RESUME:
+    case VOCTRL_SET_PANSCAN:
+        overlay_update(vo, p->overlay_pts);
+        vo->want_redraw = true;
+        return VO_TRUE;
+    }
     return VO_NOTIMPL;
 }
 
@@ -103,15 +243,60 @@ static int reconfig(struct vo *vo, struct mp_image_params *params)
     return 0;
 }
 
+// Clear the surviving SDR GUI plane before changing away from this video output.
+static void overlay_clear(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->overlay || !p->overlay_posted)
+        return;
+    int w = ANativeWindow_getWidth(p->overlay), h = ANativeWindow_getHeight(p->overlay);
+    if (w <= 0 || h <= 0) {
+        MP_ERR(vo, "overlay cleanup: invalid window dimensions %dx%d\n", w, h);
+        return;
+    }
+    ANativeWindow_Buffer buffer;
+    int result = ANativeWindow_lock(p->overlay, &buffer, NULL);
+    if (result != 0) {
+        MP_ERR(vo, "overlay cleanup: lock failed (%d)\n", result);
+        return;
+    }
+    bool valid = buffer.bits && buffer.width > 0 && buffer.height > 0 &&
+                 buffer.stride >= buffer.width && buffer.format == WINDOW_FORMAT_RGBA_8888;
+    if (valid) {
+        for (int y = 0; y < buffer.height; y++)
+            memset((uint8_t *)buffer.bits + (size_t)y * buffer.stride * 4,
+                   0, (size_t)buffer.width * 4);
+    } else {
+        MP_ERR(vo, "overlay cleanup: unexpected locked buffer geometry or format\n");
+    }
+    result = ANativeWindow_unlockAndPost(p->overlay);
+    if (result != 0) {
+        MP_ERR(vo, "overlay cleanup: post failed (%d)\n", result);
+        return;
+    }
+    if (valid) {
+        p->overlay_posted = false;
+        MP_VERBOSE(vo, "overlay cleanup: cleared on uninit\n");
+    }
+}
+
 static void uninit(struct vo *vo)
 {
     struct priv *p = vo->priv;
     mp_image_unrefp(&p->next_image);
+    overlay_clear(vo);
+    talloc_free(p->overlay_img);
+    talloc_free(p->overlay_draw_cache);
+    if (p->overlay)
+        ANativeWindow_release(p->overlay);
+    p->overlay = NULL;
+    p->overlay_posted = false;
 
     hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
     av_buffer_unref(&p->hwctx.av_device_ref);
 }
 
