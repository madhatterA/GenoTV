+    ANativeWindow *overlay;
+    struct mp_image *overlay_img;   // RGBA scratch, owned by us so the OSD path can draw in place
+    int64_t overlay_change_id;      // last sub_bitmap_list change_id drawn
+    bool overlay_posted;            // independent of redraw/resize invalidation
