 static AVBufferRef *create_mediacodec_device_ref(struct vo *vo)
 {
     AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_MEDIACODEC);
@@ -62,9 +79,115 @@ static int preinit(struct vo *vo)
     }
 
     hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+    p->overlay_pts = MP_NOPTS_VALUE;
+    return overlay_init(vo);
+}
+
+static int overlay_init(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->overlay_ref)
+        return 0;
+    JavaVM *vm = av_jni_get_java_vm(NULL);
+    JNIEnv *env = NULL;
+    bool attached = false;
+    if (vm && (*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) == JNI_EDETACHED)
+        attached = (*vm)->AttachCurrentThread(vm, &env, NULL) == 0;
+    if (!env) {
+        MP_ERR(vo, "overlay: no JNIEnv\n");
+        return -1;
+    }
+    p->overlay = ANativeWindow_fromSurface(env, (jobject)(intptr_t)p->overlay_ref);
+    if (attached)
+        (*vm)->DetachCurrentThread(vm);
+    if (!p->overlay) {
+        MP_ERR(vo, "overlay: ANativeWindow_fromSurface failed\n");
+        return -1;
+    }
+    if (ANativeWindow_setBuffersGeometry(p->overlay, 0, 0,
+                                        WINDOW_FORMAT_RGBA_8888) != 0) {
+        MP_ERR(vo, "overlay: RGBA buffer geometry failed\n");
+        return -1;
+    }
+    p->overlay_draw_cache = mp_draw_sub_alloc(p, vo->global);
+    if (!p->overlay_draw_cache) {
+        MP_ERR(vo, "overlay: software OSD cache allocation failed\n");
+        return -1;
+    }
+    p->overlay_change_id = -1;
     return 0;
 }
 
+// mpv's software OSD renderer owns subtitle decoding; only changed content is posted.
+static void overlay_update(struct vo *vo, double pts)
+{
+    struct priv *p = vo->priv;
+    if (!p->overlay)
+        return;
+    int w = ANativeWindow_getWidth(p->overlay), h = ANativeWindow_getHeight(p->overlay);
+    if (w <= 0 || h <= 0) {
+        MP_ERR(vo, "overlay: invalid window dimensions %dx%d\n", w, h);
+        return;
+    }
+    if (!p->overlay_img || p->overlay_img->w != w || p->overlay_img->h != h) {
+        talloc_free(p->overlay_img);
+        p->overlay_img = mp_image_alloc(IMGFMT_RGBA, w, h);
+        p->overlay_change_id = -1;
+    }
+    if (!p->overlay_img) {
+        MP_ERR(vo, "overlay: RGBA allocation failed\n");
+        return;
+    }
+    p->overlay_img->params.alpha = MP_ALPHA_PREMUL;
+    struct mp_osd_res res = { .w = w, .h = h, .display_par = 1.0 };
+    struct sub_bitmap_list *list = osd_render(vo->osd, res, pts, 0, mp_draw_sub_formats);
+    if (!list) {
+        MP_ERR(vo, "overlay: OSD bitmap rendering failed\n");
+        return;
+    }
+    int64_t id = list->change_id;
+    int n = list->num_items;
+    if (id == p->overlay_change_id) {
+        talloc_free(list);
+        return;
+    }
+    for (int y = 0; y < h; y++)
+        memset(p->overlay_img->planes[0] + (size_t)y * p->overlay_img->stride[0],
+               0, (size_t)w * 4); // Transparent premultiplied RGBA: 0,0,0,0.
+    bool drawn = !n || mp_draw_sub_bitmaps(p->overlay_draw_cache, p->overlay_img, list);
+    talloc_free(list);
+    if (!drawn) {
+        MP_ERR(vo, "overlay: software OSD drawing failed\n");
+        return;
+    }
+    ANativeWindow_Buffer buffer;
+    int result = ANativeWindow_lock(p->overlay, &buffer, NULL);
+    if (result != 0) {
+        MP_ERR(vo, "overlay: lock failed (%d)\n", result);
+        return;
+    }
+    bool valid = buffer.bits && buffer.width == w && buffer.height == h &&
+                 buffer.stride >= w && buffer.format == WINDOW_FORMAT_RGBA_8888;
+    if (valid) {
+        for (int y = 0; y < h; y++)
+            memcpy((uint8_t *)buffer.bits + (size_t)y * buffer.stride * 4,
+                   p->overlay_img->planes[0] + (size_t)y * p->overlay_img->stride[0],
+                   (size_t)w * 4);
+    } else {
+        MP_ERR(vo, "overlay: unexpected locked buffer geometry or format\n");
+    }
+    result = ANativeWindow_unlockAndPost(p->overlay);
+    if (result != 0) {
+        MP_ERR(vo, "overlay: post failed (%d)\n", result);
+        return;
+    }
+    if (valid) {
+        p->overlay_change_id = id;
+        p->overlay_posted = true;
+        MP_VERBOSE(vo, "overlay: posted %d items (change_id %lld)\n", n, (long long)id);
+    }
+}
