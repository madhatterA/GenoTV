+    if (r == 0 && c->dovi_profile) {
+        AVPacketSideData *sd = av_mallocz(sizeof(*sd));
+        AVDOVIDecoderConfigurationRecord *cfg = av_mallocz(sizeof(*cfg));
+        if (!sd || !cfg) {
+            av_free(sd);
+            av_free(cfg);
